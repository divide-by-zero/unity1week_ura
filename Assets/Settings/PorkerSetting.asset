  <ShopItemMessageDictionary>k__BackingField:
    keyValuePairs:
    - key: 0
      value:
        Message: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u6570\u5B57\u3092\uFF11\u301C\uFF13\u30E9\u30F3\u30C0\u30E0\u3067\u4E0A\u3052\u308B\u3053\u3068\u304C\u51FA\u6765\u307E\u3059\u3088\uFF01\n\u3061\u306A\u307F\u306BK\u306E\u4E0A\u306FA\u3067\u3059\u3051\u3069\u3001A\u3092\u8D85\u3048\u305F\u3089\u30FB\u30FB\u30FB\u3002\n\u3069\u3046\u306A\u3063\u3061\u3083\u3046\u3093\u3067\u3057\u3087\u3046\u306D\uFF1F"
        NormalMessage: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u6570\u5B57\u3092\u4E00\u3064\u4E0A\u3052\u308B"
    - key: 1
      value:
        Message: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u30DE\u30FC\u30AF\u3092\u5909\u66F4\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u307E\u3059\u3088\uFF01"
        NormalMessage: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u30DE\u30FC\u30AF\u3092\u5909\u66F4"
    - key: 2
      value:
        Message: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u77E2\u5370\u306E\u5411\u304D\u3092\u5909\u66F4\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u307E\u3059\u3088\uFF01\n\u305F\u3060\u3057\u3001\u30E9\u30F3\u30C0\u30E0\u306A\u306E\u3067\u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D\u3002"
        NormalMessage: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u77E2\u5370\u306E\u5411\u304D\u5909\u66F4"
    - key: 3
      value:
        Message: "\u540C\u3058\u6570\u5B57\u306E\u30AB\u30FC\u30C9\u3092\uFF12\u679A\u9078\u629E\u3057\u3066\u3001\u77E2\u5370\u3092\u307E\u3068\u3081\u308B\u3053\u3068\u304C\u51FA\u6765\u307E\u3059\u3088\uFF01\n\uFF11\u679A\u306F\u77E2\u5370\u7121\u3057\u306B\u306A\u3063\u3061\u3083\u3046\u306E\u3067\u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D"
        NormalMessage: "\u540C\u3058\u6570\u5B57\u306E\u30AB\u30FC\u30C92\u679A\u3092\u9078\u3093\u3067\u3001\n\u77E2\u5370\u3092\u7247\u65B9\u306B\u307E\u3068\u3081\u308B"
    - key: 4
      value:
        Message: "\u30AB\u30FC\u30C9\u3092\uFF11\u679A\u8FFD\u52A0\u3057\u307E\u3059\u3088\uFF01\n\u3082\u3061\u308D\u3093\u3001\uFF11\u679A\u6368\u3066\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3067\u3059"
        NormalMessage: "\u30AB\u30FC\u30C91\u679A\u8FFD\u52A0"
    - key: 5
      value:
        Message: "HP\u3092\uFF11\u56DE\u5FA9\u3057\u307E\u3059\u3002\nHP\u304C0\u306B\u306A\u308B\u3068\u6B7B\u3093\u3058\u3083\u3046\u306E\u3067\u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044"
        NormalMessage: "HP1\u56DE\u5FA9"
    - key: 6
      value:
        Message: "\u3044\u3064\u3067\u3082\u30AB\u30FC\u30C9\u3092\u5165\u308C\u66FF\u3048\u3067\u304D\u307E\u3059\uFF01\n\u4FBF\u5229\u3067\u3059\u306D\uFF01"
        NormalMessage: "\u30AB\u30FC\u30C9\u5165\u308C\u66FF\u3048"
    - key: 7
      value:
        Message: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u77E2\u5370\u3092\u8FFD\u52A0\u51FA\u6765\u307E\u3059\n\u5168\u77E2\u5370\u304C\u4ED8\u3044\u305F\u30AB\u30FC\u30C9\u306B\u306F\u4F7F\u3048\u306A\u3044\u306E\u3067\u6C17\u3092\u4ED8\u3051\u3066\u304F\u3060\u3055\u3044\u306D\u3002"
        NormalMessage: "\u30AB\u30FC\u30C9\u30921\u679A\u9078\u3093\u3067\u3001\u77E2\u5370\u8FFD\u52A0"
    - key: 8
      value:
        Message: "\u54C1\u63C3\u3048\u304C\u6C17\u306B\u98DF\u308F\u306A\u3044\u306A\u3089\u3001\u304A\u91D1\u6255\u3063\u3066\u304F\u308C\u308C\u3070\u6E96\u5099\u3057\u76F4\u3057\u307E\u3059\u3088\u3002"
        NormalMessage: 
